{
  "name": "@lucius-vac/short-asset-golden-case-support-dc",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e .env.local -- sh -c \"NODE_OPTIONS='--max-http-header-size=65536 --import ./instrument.server.mjs' vite dev --port 3000\"",
    "build": "vite build",
    "preview": "dotenv -e .env.local -- sh -c \"NODE_OPTIONS='--max-http-header-size=65536 --import ./instrument.server.mjs' vite preview\"",
    "test": "vitest run",
    "stripe:setup-billing": "dotenv -e .env.local -- tsx scripts/setup-stripe-billing-catalog.ts",
    "post-cta-init": "npx create-db@latest --user-agent tanstack/tsrouter",
    "db:types": "dotenv -e .env.local -- sh -c 'mkdir -p src/types && npx supabase gen types typescript --project-id \"$SUPABASE_PROJECT_REF\" --schema public > src/types/database.generated.ts'",
    "start": "sh -c \"NODE_OPTIONS='--max-http-header-size=65536 --import ./instrument.server.mjs' vite preview --host 0.0.0.0 --port ${PORT:-8080}\"",
    "dev:demo": "node ./scripts/run-demo-vite.mjs dev --port 3000",
    "build:demo": "node ./scripts/run-demo-vite.mjs build",
    "preview:demo": "node ./scripts/run-demo-vite.mjs preview --host 0.0.0.0 --port 3000"
  },
